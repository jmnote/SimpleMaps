{
  "name": "SimpleMaps",
  "version": "0.2.1",
  "author": "jmnote",
  "url": "https://github.com/zetaoss/SimpleMaps",
  "description": "Simple and modern map display extension for MediaWiki.",
  "license-name": "Apache-2.0",
  "type": "parserhook",
  "requires": {
    "MediaWiki": ">= 1.43.0"
  },
  "AutoloadNamespaces": {
    "SimpleMaps\\": "src/"
  },
  "ResourceModules": {
    "ext.simplemaps.main": {
      "scripts": ["resources/main.js"],
      "styles": ["resources/main.css"],
      "messages": [],
      "targets": ["desktop", "mobile"]
    }
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "SimpleMaps"
  },
  "Hooks": {
    "ParserFirstCallInit": "SimpleMaps\\Hooks::onParserFirstCallInit"
  },
  "config": {
    "SimpleMapsWidth": {
      "value": "100%"
    },
    "SimpleMapsHeight": {
      "value": "400px"
    },
    "SimpleMapsZoom": {
      "value": 14
    },
    "SimpleMapsMarkerColor": {
      "value": "blue"
    },
    "SimpleMapsShapeColor": {
      "value": "red"
    },
    "SimpleMapsLeafletDistUrl": {
      "value": "https://unpkg.com/leaflet@1.9.4/dist/"
    }
  },
  "manifest_version": 2
}
